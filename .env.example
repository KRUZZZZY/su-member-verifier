# Discord Bot Token — from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord Server (Guild) ID — right-click server icon → Copy ID
DISCORD_GUILD_ID=123456789012345678

# Discord Role ID to assign verified members — right-click role → Copy ID
DISCORD_VERIFIED_ROLE_ID=123456789012345678

# SU / MSL config
SU_BASE_URL=https://www.swansea-union.co.uk
SU_SOCIETY_SLUG=your-society-slug
# Path to the member list page (MSL auto-discovers if not set)
SU_MEMBER_LIST_PATH=/organisation/memberlist/

# CSV file path (exported from Google Forms: Responses → Download .csv)
CSV_PATH=responses.csv

# Optional: headless mode for the browser
HEADLESS=false
