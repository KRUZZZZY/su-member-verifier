# Discord Bot Token — paste yours here (ask a committee member with Developer Portal access)
DISCORD_BOT_TOKEN=

# Discord Server (pre-filled for Swansea Esports)
DISCORD_GUILD_ID=447142229639954462

# Verified Member Role (pre-filled for Swansea Esports)
DISCORD_VERIFIED_ROLE_ID=1412073058616868945

# SU / MSL config (pre-filled for Swansea Esports)
SU_BASE_URL=https://www.swansea-union.co.uk
SU_SOCIETY_SLUG=esports
SU_MEMBER_LIST_PATH=/organisation/memberlist/27191/

# CSV file path (or use CSV_URL below for auto-fetch)
CSV_PATH=responses.csv

# Secure Google Apps Script URL (get the full URL with key from a committee admin)
# This is key-protected — without the key, requests return "Access denied"
CSV_URL=

# Column names in the CSV (must match the Google Form questions)
CSV_COL_DISCORD_USER=Provide your discord username
CSV_COL_STUDENT_EMAIL=Provide your student email
CSV_COL_STUDENT_ID=Provide your student ID

# Headless mode (set to true to hide the browser during scrape)
HEADLESS=false
